# ============================================================
#  AiProf Frontend — Environment Variables
#  Copy this file to .env or .env.local in frontend/
# ============================================================

# Backend API base URL (defaults to '/api' via Vite proxy if blank)
VITE_API_URL=http://localhost:8080

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Ensure 'http://localhost:5173' is registered under 'Authorized JavaScript origins'
VITE_GOOGLE_CLIENT_ID=
