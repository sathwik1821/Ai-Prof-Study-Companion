# ============================================================
#  AiProf — Local Development Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git (it is included in .gitignore).
# ============================================================

# ── Database (PostgreSQL 16 with pgvector) ────────────────────
DATABASE_NAME=study_companion
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/study_companion

# ── JWT Authentication ────────────────────────────────────────
# Secret key must be at least 256 bits (32 characters) for HMAC-SHA256
JWT_SECRET=aiprof-local-dev-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# ── Google Gemini AI API ──────────────────────────────────────
# Required for RAG vector embeddings, Socratic AI tutoring, and adaptive quiz generation
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google OAuth 2.0 Client ID (Frontend / Backend) ───────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=420129371421-b880kb1kth6j6ge47vo94o9ronn8de31.apps.googleusercontent.com

# ── Email Delivery (Optional) ─────────────────────────────────
# Option A: Resend HTTP REST API (Recommended for cloud hosting like Render - port 443)
RESEND_API_KEY=
RESEND_FROM=AiProf <onboarding@resend.dev>

# Option B: Standard Gmail SMTP (Port 587)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Server ────────────────────────────────────────────────────
PORT=8080
