# ============================================================
#  AiProf — Local Development Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git (it's already in .gitignore).
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_NAME=study_companion
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/study_companion

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=aiprof-local-dev-secret-key-change-this-in-production-must-be-at-least-256-bits

# ── Google Gemini API ─────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Server ────────────────────────────────────────────────────
PORT=8080
